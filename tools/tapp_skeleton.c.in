/**
 * @NAME@ - a tape! application
 *
 * Generated by `make init`. No manifest file is needed: tapp-build generates one and reads the
 * app's display name from `.name` in the descriptor below.
 *
 * Build:   ./tapp-build @NAME@          -> @NAME@.tapp
 * Deploy:  copy @NAME@.tapp into the "apps" folder on the SD card (disk mode); it then shows up
 *          in the setup menu.
 *
 * Add more .c files next to this one and they are compiled together. An `inc/` folder is added to
 * the include path automatically, and an `assets/` folder is converted to bitmaps.
 */

#include "tapp_api.h"

/* The system hints start hidden and drop over the top of the screen when the user reveals them.
 * Keep your own drawing below them or the hints cover it. */
#define TOP_BAR 60

typedef struct {
    int counter;
} app_model_t;

static void app_redraw(gfx_t* gfx, const os_app_t* app) {
    app_model_t* model = os_app_get_model(app);

    gfx_set_color(gfx, 1);
    gfx_draw_strf(gfx, 4, TOP_BAR + 20, "counter: %d", model->counter);
    gfx_draw_str(gfx, 4, TOP_BAR + 44, "BTN1 +1");
}

static bool app_tick(os_app_t* app) {
    (void)app;
    /* This return is what schedules redraw(). False is right here — the counter below only
     * changes on a button press, and a press already earns a frame (so do focus changes and
     * an animating menu or popup).
     *
     * The moment anything moves on its own — a sprite, an ease, a meter, a playhead, a
     * timeout — return true while it is moving, or it paints one frame and stops. Drive it
     * from os_tick_get() (real milliseconds, runs whether or not you paint), NOT from
     * ui_get_frame(), which counts paints and so stops for good once you stop asking. */
    return false;
}

static bool app_init(os_app_t* app, va_list args) {
    (void)args;
    app_model_t* model = os_app_get_model(app);
    model->counter = 0;

    /* The statusbar is already on when a tapp loads; call ui_statusbar_show(false) for the full
     * screen. The hints start HIDDEN, and a utility tapp gets no firmware gesture to reveal
     * them — so raise them yourself if you want them, as below. One label pair per button:
     * {press, hold}; 0 or "" leaves that action blank. All ten cells are ours, both HOLD cells
     * included. BTN4/BTN5 sit in a narrow (~50px) column — keep those labels very short. */
    static const tapp_hint_pair_t hints[5] = {
        {"+1", 0},
        {0, 0},
        {0, 0},
        {0, "exit"},
        {0, 0},
    };
    ui_hints_set_labels(hints);
    ui_hints_show(true);

    return true;
}

static bool app_deinit(os_app_t* app) {
    (void)app;
    return true;
}

static void app_input(os_app_t* app, uint8_t btn, KeyStateEnum state) {
    app_model_t* model = os_app_get_model(app);

    if(btn == 0 && state == KEY_STATE_PRESSED) {
        model->counter++;
        /* No need to ask for a repaint here — an input event already earns one. needs_redraw
         * is the firmware's field; ask through app_tick()'s return instead. */
    }
    /* We declare no TAPP_DECLARE_TYPE, so this is a UTILITY tapp: the firmware claims none
     * of our buttons, every hold arrives here, and the way out is ours to provide. A BTN4
     * hold is the convention — rebind it if your app needs that button and exit elsewhere. */
    if(btn == 3 && state == KEY_STATE_HOLD) {
        os_app_exit();
    }
}

/* Both of these MUST use static initialisers — the loader reads them before any code runs. */
static os_app_data_t app_data = {
    .model = NULL,
    .model_size = sizeof(app_model_t),
    .init = app_init,
    .deinit = app_deinit,
};

static os_app_t app_descriptor = {
    .name = "@NAME@", /* shown in the menu, and scraped by tapp-build for the manifest */
    .type = AppFullscreenType,
    .data = &app_data,
    .redraw = (os_app_redraw)app_redraw,
    .tick = app_tick,
    .on_input = app_input,
};

/* Entry point — the name is required, the loader looks it up by symbol. */
os_app_t* tapp_get_descriptor(void) {
    return &app_descriptor;
}
